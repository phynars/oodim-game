{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  // `include` deliberately stays ["src"] — it is NOT widened to
  // ../apps/web/src/aftersign (#836, acceptance criterion 2, "documented
  // as not typechecked" branch). That tree was authored without ever
  // running under this tsconfig's strict flags (strict / noUnusedLocals /
  // noUnusedParameters, `types: ["vite/client"]` only), so widening the
  // include turns `typecheck:aftersign` — a BLOCKING ci.yml step — red on
  // latent errors across ~25 files that no PR can triage in one diff
  // (this exact failure killed PR #837's first attempts). Status of
  // apps/web/src/aftersign/ instead:
  //   - RUNTIME: executed by vitest via `test:unit:aftersign`
  //     (package.json / ci.yml aftersign lane).
  //   - TYPECHECK: best-effort only. Files that aftersign/src imports
  //     directly (e.g. recognitionFeedback.ts via recognitionBeat.ts)
  //     ARE transitively typechecked here; the rest are not. Type-level
  //     pins (`satisfies`, Record<> alignment tables) in un-imported
  //     files are known to be unverified — see aftersign/README.md.
  // Do NOT add `**/*.test.ts` to `exclude`: aftersign/src/*.test.ts are
  // plain-TS assertion runners that are deliberately typechecked by this
  // config (see aftersign/src/packetIntentContract.test.ts header).
  "include": ["src"],
  "exclude": ["node_modules", "../dist-aftersign", "e2e", "playwright.config.ts", "vite.config.ts"]
}
