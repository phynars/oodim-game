{
  // PROD: game.oodim.com Worker. Serves the built static portfolio
  // (assets.directory ./public, bound as ASSETS) AND hosts the agar
  // multiplayer server — `/ws` routes to the EchoRoom Durable Object via the
  // src/server.ts entry. (Before 2026-06-23 this was assets-only and the agar
  // DO was dev-only, so game.oodim.com/ws 404'd — "no one is listening".)
  //
  // account_id is intentionally NOT here (public repo); supplied at deploy time
  // via CLOUDFLARE_ACCOUNT_ID. Custom domain provisioned on deploy (token needs
  // Workers Scripts + Zone DNS edit on oodim.com). Staging mirror:
  // wrangler.staging.jsonc → staging.game.oodim.com.
  "name": "oodim-game",
  "main": "src/server.ts",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ECHO_ROOM", "class_name": "EchoRoom" },
      // AFTERSIGN authoritative player-memory (issue #1635). One DO instance
      // per stable player identity (idFromName(x-player-id header)); persists
      // delivery-outcome + route-attention facts durably so records survive
      // any client-side localStorage clear. Class exported from src/server.ts
      // (re-export of apps/web/src/aftersign/playerMemoryBackend.ts).
      { "name": "PLAYER_MEMORY", "class_name": "AftersignPlayerMemory" },
      // AFTERSIGN authoritative full-snapshot save (PR #2065 re-review).
      // One DO instance per `${playerId}::${slot}` pair. The first draft
      // kept saves in a module-level `new Map()`, which Workers isolates
      // can drop on recycle/eviction — a GET after a PUT could 404 a
      // committed save. The DO's `state.storage` is the correct substrate.
      // Class exported from src/server.ts (re-export of
      // apps/web/src/aftersign/authoritativeSaveBackend.ts).
      { "name": "AFTERSIGN_SAVE", "class_name": "AftersignAuthoritativeSave" }
    ]
  },
  // Per-IP throttle on the unauthenticated /ws upgrade (2026-07-09 hardening):
  // 20 connections / 60s / client IP. Free-plan-friendly (runs in the Worker,
  // not a WAF rule). period must be 10 or 60.
  "ratelimits": [
    { "name": "WS_RATELIMIT", "namespace_id": "1101", "simple": { "limit": 20, "period": 60 } },
    // Per-IP throttle on AFTERSIGN writes (PUT/DELETE /aftersign/save/*,
    // POST /player-memory): 120 writes / 60s / client IP. The client
    // writes on story choices, not per frame, so a real player sits far
    // below this; the headroom is for shared NAT (classrooms, campus wifi).
    { "name": "AFTERSIGN_WRITE_RATELIMIT", "namespace_id": "1102", "simple": { "limit": 120, "period": 60 } }
  ],
  "migrations": [
    { "tag": "v1", "new_classes": ["EchoRoom"] },
    // AFTERSIGN player-memory (issue #1635) — new DO class introduced by
    // this migration. Deploy-only concern; no data migration since the
    // class is new. Persisted storage is per-instance
    // (state.storage.get/put) and starts empty.
    { "tag": "v2", "new_classes": ["AftersignPlayerMemory"] },
    // AFTERSIGN authoritative save (PR #2065 re-review) — new DO class
    // for the full-snapshot save endpoint. One instance per
    // `${playerId}::${slot}` pair; starts empty. Replaces a module-level
    // `new Map()` that could not survive Workers isolate eviction.
    { "tag": "v3", "new_classes": ["AftersignAuthoritativeSave"] }
  ],
  "routes": [
    { "pattern": "game.oodim.com", "custom_domain": true }
  ]
}
